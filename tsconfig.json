{
  "compilerOptions": {
    "module": "esnext",
    "jsx": "react-jsx",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "bun-types"],
    "baseUrl": ".",
    "paths": { "src/*": ["./src/*"] }
  },
  "include": ["src", "vite.config.ts"]
}
